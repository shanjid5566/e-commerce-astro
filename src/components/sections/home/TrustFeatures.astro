---
// src/components/sections/home/TrustFeatures.astro
---

<section class="py-12 bg-indigo-950 text-white">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">

      <!-- Fast Delivery -->
      <div class="flex items-center gap-4 p-4 rounded-xl bg-indigo-900/40 border border-indigo-800/50">
        <div class="w-12 h-12 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 17H3a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v3"/>
            <rect x="9" y="11" width="14" height="10" rx="1"/>
            <circle cx="12" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold">Fast BD Delivery</h4>
          <p class="text-xs text-slate-400">2-3 Days Home Delivery</p>
        </div>
      </div>

      <!-- Quality Fabric -->
      <div class="flex items-center gap-4 p-4 rounded-xl bg-indigo-900/40 border border-indigo-800/50">
        <div class="w-12 h-12 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            <path d="m9 12 2 2 4-4"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold">100% Quality Fabric</h4>
          <p class="text-xs text-slate-400">Guaranteed Winter Warmth</p>
        </div>
      </div>

      <!-- Easy Return -->
      <div class="flex items-center gap-4 p-4 rounded-xl bg-indigo-900/40 border border-indigo-800/50">
        <div class="w-12 h-12 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/>
            <path d="M21 3v5h-5"/>
            <path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/>
            <path d="M8 16H3v5"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold">7-Day Easy Return</h4>
          <p class="text-xs text-slate-400">Hassle-free Replacement</p>
        </div>
      </div>

      <!-- Phone Support -->
      <div class="flex items-center gap-4 p-4 rounded-xl bg-indigo-900/40 border border-indigo-800/50">
        <div class="w-12 h-12 rounded-xl bg-rose-500/10 text-rose-400 flex items-center justify-center shrink-0">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 18v-6a9 9 0 0 1 18 0v6"/>
            <path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>
          </svg>
        </div>
        <div>
          <h4 class="text-sm font-bold">24/7 Phone Support</h4>
          <p class="text-xs text-slate-400">Dedicated Customer Care</p>
        </div>
      </div>

    </div>
  </div>
</section>
