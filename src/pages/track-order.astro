---
// src/pages/track-order.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import OrderTracker from '../components/react/OrderTracker';
---

<BaseLayout title="Track Your Order | WinterCart BD">
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12">
    
    {/* Breadcrumbs Navigation */}
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 sm:mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-rose-500 transition">Home</a>
      <span class="text-slate-300">/</span>
      <span class="text-slate-900 font-semibold">Track Order</span>
    </nav>

    {/* Hero Header */}
    <div class="text-center max-w-xl mx-auto space-y-3 mb-10">
      <span class="text-xs font-bold text-rose-500 uppercase tracking-widest bg-rose-50 px-3 py-1 rounded-md border border-rose-100">
        Live Parcel Status
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-indigo-950 tracking-tight">
        Track Your Winter Order
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
        Enter your Order ID (sent via SMS) and recipient phone number to track your courier shipment across Bangladesh.
      </p>
    </div>

    {/* Interactive Tracker React Component */}
    <OrderTracker client:load />

  </div>
</BaseLayout>

