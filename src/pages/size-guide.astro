---
// src/pages/size-guide.astro
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicSizeGuideView from '../components/react/PublicSizeGuideView';
import { getSizeCharts, getMeasurementTips } from '../services/sizeGuideService';

const charts = await getSizeCharts();
const tips = await getMeasurementTips();
---

<BaseLayout
  title="Winter Apparel Size Guide & Measurement Chart | WinterCart"
  description="Find your perfect fit for hoodies, leather jackets, sweaters, and thermals with WinterCart's detailed Asian & European chest, length, and sleeve measurement charts."
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-12">
    
    {/* Breadcrumbs Navigation */}
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-6 sm:mb-8" aria-label="Breadcrumb">
      <a href="/" class="hover:text-rose-500 transition">Home</a>
      <span class="text-slate-300">/</span>
      <span class="text-slate-900 font-semibold">Size Guide</span>
    </nav>

    {/* Hero Header */}
    <div class="text-center max-w-xl mx-auto space-y-3 mb-12">
      <span class="text-xs font-bold text-rose-500 uppercase tracking-widest bg-rose-50 px-3 py-1 rounded-md border border-rose-100">
        Fit Confidence
      </span>
      <h1 class="text-3xl sm:text-4xl font-black text-indigo-950 tracking-tight">
        Winter Apparel Size Guide
      </h1>
      <p class="text-xs sm:text-sm text-slate-500 leading-relaxed">
        Find your exact fit across hoodies, jackets, knit sweaters, and thermal base layers before placing your order.
      </p>
    </div>

    {/* Dynamic Public Size Guide View */}
    <PublicSizeGuideView
      initialCharts={charts}
      initialTips={tips}
      client:load
    />

  </div>
</BaseLayout>
