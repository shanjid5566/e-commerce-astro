---
// src/pages/admin/products/[id]/edit.astro
import AdminLayout from '../../../../layouts/AdminLayout.astro';
import AdminProductForm from '../../../../components/react/admin/AdminProductForm';
import { getProducts, getCategories } from '../../../../services/productService';

export async function getStaticPaths() {
  const products = await getProducts();
  const categories = await getCategories();
  return products.map((product) => ({
    params: { id: product.id },
    props: { product, categories },
  }));
}

const { product, categories } = Astro.props;

if (!product) {
  return Astro.redirect('/admin/products');
}
---

<AdminLayout
  title={`Edit ${product.title}`}
  heading="Edit Product Details"
  subheading={`Updating SKU #${product.id} • ${product.category}`}
>
  <AdminProductForm
    initialProduct={product}
    categories={categories}
    isEdit={true}
    client:load
  />
</AdminLayout>
