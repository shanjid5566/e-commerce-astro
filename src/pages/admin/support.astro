---
// src/pages/admin/support.astro
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminSupportManager from '../../components/react/admin/AdminSupportManager';
import { getSupportMessages } from '../../services/supportService';

const messages = await getSupportMessages();
---

<AdminLayout
  title="Customer Inquiries"
  heading="Contact Form Submissions"
  subheading="Manage inquiries submitted directly by customers through the website contact form, review messages, and send responses."
>
  <AdminSupportManager
    initialMessages={messages}
    client:load
  />
</AdminLayout>
