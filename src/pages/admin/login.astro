---
// src/pages/admin/login.astro
import '../../styles/global.css';
import AdminLoginForm from '../../components/react/AdminLoginForm';
---

<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login | WinterCart Bangladesh</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
  </head>
  <body class="min-h-full flex flex-col justify-between font-['Plus_Jakarta_Sans',sans-serif] bg-radial-[at_top] from-slate-100 via-slate-50 to-slate-100 text-slate-900 antialiased selection:bg-rose-500 selection:text-white">

    {/* Admin Top Header */}
    <header class="py-6 px-4 sm:px-8">
      <div class="max-w-6xl mx-auto flex items-center justify-between">
        
        {/* Brand Logo with Admin badge */}
        <a href="/" class="flex items-center gap-2 text-xl font-black text-indigo-950 tracking-tight">
          <div class="w-9 h-9 rounded-xl bg-rose-500 flex items-center justify-center text-white shadow-md shadow-rose-200">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
              <line x1="3" y1="6" x2="21" y2="6"/>
              <path d="M16 10a4 4 0 0 1-8 0"/>
            </svg>
          </div>
          <span>Winter<span class="text-rose-500">Cart</span></span>
          <span class="ml-2 text-[10px] font-extrabold uppercase px-2 py-0.5 rounded-md bg-indigo-950 text-white tracking-widest">
            Admin
          </span>
        </a>

        {/* Back to shop button */}
        <a
          href="/"
          class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-slate-600 hover:text-rose-500 transition px-3.5 py-1.5 rounded-xl border border-slate-200 bg-white shadow-2xs hover:border-rose-200"
        >
          <span>Visit Storefront</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/>
            <line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </a>
      </div>
    </header>

    {/* Center Auth Container */}
    <main class="flex-1 flex items-center justify-center px-4 py-8 sm:py-12">
      <AdminLoginForm client:load />
    </main>

    {/* Admin Footer */}
    <footer class="py-6 px-4 text-center text-xs text-slate-400">
      <p>&copy; {new Date().getFullYear()} WinterCart Bangladesh Inc. Restricted Internal System.</p>
    </footer>

  </body>
</html>

