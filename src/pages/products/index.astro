---
// src/pages/products/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import ShopCatalog from '../../components/react/ShopCatalog';
import { getProducts, getCategories } from '../../services/productService';

const products = await getProducts();
const categories = await getCategories();
---

<BaseLayout
  title="Shop All Winter Clothing | Premium Hoodies, Jackets & Knitwear - WinterCart"
  description="Explore our full collection of premium winter apparel in Bangladesh. Heavyweight fleece hoodies, genuine leather jackets, cozy sweaters, and thermal layers."
>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-10">
    
    {/* Breadcrumbs Navigation */}
    <nav class="flex items-center gap-2 text-xs text-slate-500 mb-3 sm:mb-6" aria-label="Breadcrumb">
      <a href="/" class="hover:text-rose-500 transition">Home</a>
      <span class="text-slate-300">/</span>
      <span class="text-slate-900 font-semibold">Shop All</span>
    </nav>

    {/* Interactive 2-Column Catalog (Left Category Sidebar + Right Product Cards Grid) */}
    <ShopCatalog
      initialProducts={products}
      categories={categories}
      client:load
    />

  </div>
</BaseLayout>

